{
  "name": "metamorfosis-web",
  "version": "4.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.public.config.js",
    "dev:public": "vite --config vite.public.config.js",
    "dev:admin": "vite --config vite.admin.config.js",
    "dev:server": "NODE_ENV=development node server.js",
    "build": "npm run build:admin",
    "build:public": "vite build --config vite.public.config.js",
    "build:admin": "vite build --config vite.admin.config.js",
    "preview:public": "vite preview --config vite.public.config.js --host 0.0.0.0 --port ${PORT:-4173}",
    "start": "NODE_ENV=production node server.js",
    "check": "npm run build",
    "build:all": "npm run build:public && npm run build:admin"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "compression": "1.8.1",
    "connect-pg-simple": "10.0.0",
    "dotenv": "16.4.7",
    "express": "4.22.2",
    "express-rate-limit": "7.5.0",
    "express-session": "1.19.0",
    "helmet": "8.0.0",
    "pg": "8.13.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "vite": "8.1.0",
    "nodemailer": "6.9.16"
  },
  "engines": {
    "node": "20.19.0",
    "npm": ">=10.0.0"
  }
}
