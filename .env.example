# Servidor privado / Metamorfosis OS
PORT=4173
NODE_ENV=development
SESSION_SECRET=reemplazar-por-un-secreto-largo-y-aleatorio

# PostgreSQL / Neon: permite que las solicitudes queden compartidas en Metamorfosis OS
DATABASE_URL=

# Acceso administrativo
ADMIN_EMAIL=contacto@metamorfosislab.cl
# Generar con: node -e "console.log(require('bcryptjs').hashSync('TU_CLAVE', 12))"
ADMIN_PASSWORD_HASH=

# Dominios autorizados para enviar formularios a la API privada
PUBLIC_ORIGINS=http://localhost:5173,https://metamorfosislab.cl,https://www.metamorfosislab.cl

# Correo formal del formulario web
CONTACT_TO_EMAIL=contacto@metamorfosislab.cl
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contacto@metamorfosislab.cl
SMTP_PASS=
SMTP_FROM=contacto@metamorfosislab.cl

# Variables de compilación Vite
VITE_PUBLIC_SITE_URL=https://www.metamorfosislab.cl
VITE_ADMIN_URL=/admin
# Si la API privada vive en otro servicio Render, poner aquí su URL, por ejemplo:
# VITE_API_BASE=https://metamorfosis-os.onrender.com
VITE_API_BASE=

# Solo desarrollo local. Nunca activar en producción.
DEMO_ADMIN=false
